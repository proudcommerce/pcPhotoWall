# Defense-in-depth: keine Script-Ausfuehrung im Upload-Verzeichnis
<FilesMatch "\.(php|phtml|phar|phps|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
